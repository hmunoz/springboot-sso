  "cards": [
    {
      "dot": "cyan",
      "title": "El 401 es la documentacion",
      "items": [
        "El cliente no sabe nada de Keycloak al arrancar",
        "El WWW-Authenticate le indica donde leer la metadata RFC 9728",
        "Por eso no hace falta un bridge stdio en Node"
      ]
    },
    {
      "dot": "emerald",
      "title": "Solo lectura por construccion",
      "items": [
        "El token sale por videoclub-mcp, no por videoclub-frontend",
        "Su scope solo admite movie-permission-read y socio-permission-read",
        "Un permiso de escritura no se bloquea: nunca entra al token"
      ]
    }
  ]
