      },
      {
        "id": "consulta",
        "label": "Consulta autorizada",
        "focus": [
          "cliente",
          "mcp",
          "db"
        ],
        "note": "El JWT se valida y el PreAuthorize del delegado decide antes de tocar la base."
      }
