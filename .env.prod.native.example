# ==============================================================================
# Production Environment Configuration Template (springboot-sso)
# ==============================================================================
APP_VERSION=1.0.0
SERVER_PORT=8080

# Database (PostgreSQL en red Docker videoclub)
JDBC_DATABASE_URL=jdbc:postgresql://postgresql:5432/video
JDBC_DATABASE_USERNAME=postgres
JDBC_DATABASE_PASSWORD=P4ssword!

# RabbitMQ (en red Docker videoclub)
RABBITMQ_HOST=rabbit
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASS=rabbitmq
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_EXCHANGE=keycloak.events

# Keycloak (SSO)
# - KEYCLOAK_ISSUER_URI: Debe coincidir exactamente con el claim `iss` del token JWT emitido por Keycloak
# - KEYCLOAK_JWK_SET_URI: Endpoint interno para validar la firma de los tokens via red Docker
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=videoclub
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/videoclub
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/videoclub/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=videoclub-frontend
KEYCLOAK_BACKEND_CLIENT_ID=videoclub-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=dstNSsANvqlaGfZCJa1mcYzP1EBAYP4N

# --- Variante de imagen nativa (GraalVM) ---
# Seleccionan la etapa del Dockerfile y el sufijo del tag. Ver docker-compose.prod.yml.
BUILD_TARGET=native-runtime
IMAGE_SUFFIX=-native