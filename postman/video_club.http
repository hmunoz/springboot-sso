# ====================================================================
# 4. Observabilidad y Documentación (Backend :8080)
# ====================================================================

###
# @name actuator_health
GET http://{{host}}:{{backend_port}}/metrics/health

> {%
    client.test("Actuator health executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

###
# @name api_docs
GET http://{{host}}:{{backend_port}}/api-docs

